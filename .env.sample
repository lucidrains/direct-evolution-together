# Copy this file to .env and fill in your own values.
# .env is gitignored; never commit production hosts, domains, or secrets.

# --- Remote deployment (Fabric) -------------------------------------------
# SSH host or ~/.ssh/config alias, and optional SSH user.
DEPLOY_HOST=your-ssh-host
DEPLOY_USER=

DEPLOY_APP_NAME=direct-evolution-together
DEPLOY_DIR=/var/www/direct-evolution-together
DEPLOY_DOMAIN=example.com www.example.com

# Set to an empty value to serve at the domain root.
DEPLOY_SUBPATH=/evolution

DEPLOY_HTTP_PORT=8000
DEPLOY_WS_PORT=8001
DEPLOY_UVICORN_WORKERS=2
DEPLOY_PYTHON_VERSION=3.11
# Process supervisor on remote host: "pm2" (default, generated remotely outside repo) or "systemd".
DEPLOY_PROCESS_MANAGER=pm2

# Optional GPU selection passed to the runtime; empty hides all GPUs.
DEPLOY_CUDA_VISIBLE_DEVICES=

# Optional: patch an existing Nginx vhost instead of creating a standalone one.
# Example: /etc/nginx/sites-enabled/example.com
NGINX_VHOST_FILE=

# Optional overrides; when omitted they are derived from DEPLOY_DOMAIN.
# DEPLOY_ALLOWED_HOSTS=example.com,www.example.com,127.0.0.1,localhost
# DEPLOY_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# Required for production deploys. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DEPLOY_SECRET_KEY=
DEPLOY_ADMIN_PASSWORD=

# --- GA defaults ----------------------------------------------------------
# Applied to public rooms and used as private-room defaults.
MUMMY_POP_SIZE=30
MUMMY_MIN_VOTES=20
MUMMY_MAX_VOTES=20
MUMMY_MUT_SIGMA=0.35
MUMMY_ELITE_FRAC=0.10
MUMMY_CROSSOVER_RATE=0.75

# --- Per-environment overrides --------------------------------------------
# Feature flag: enable 250-member Microduck Gait + 1,024 room population cap.
# DET_LARGE_POP=1
#
# TASK is one of IMAGE, CARTPOLE, HALFCHEETAH, MICRODUCK, UNITREE_GO2, SO101, EXTERNAL.
# Quorum, population, elite fraction, and execution policy can be tuned per task.
# Defaults come from DEFAULT_ENV_POLICIES in direct_evolution_together/config.py.
# DET_MIN_VOTES_HALFCHEETAH=8
# DET_ELITE_FRAC_HALFCHEETAH=0.05
# DET_POP_SIZE_HALFCHEETAH=16
# DET_MAX_POP_SIZE_HALFCHEETAH=24
# DET_EXECUTION_POLICY_HALFCHEETAH=client_locked
# DET_CROWD_CONTRIBUTE_HALFCHEETAH=1

# --- Local runtime (optional) ---------------------------------------------
# The deployment tasks render these into the server's runtime .env for you.
# Set them explicitly only when running the app directly.
# DJANGO_DEBUG=1
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# DJANGO_CSRF_TRUSTED_ORIGINS=
# DET_DB_PATH=
# DET_SUBPATH=
# DET_WS_PROXY=
# DET_ADMIN_PASSWORD=
# MUMMY_WS_HOST=127.0.0.1
# MUMMY_WS_PORT=8001
